# 复制为 .env 后填写密钥。.env 被 Git 忽略，请勿提交真实配置。
# 进程环境变量优先于本文件；切换 provider 会读取各自独立的模型和 key。
HARNESS_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 官方接口留空；兼容网关填服务商给出的 Anthropic base URL。
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=
# 官方 API 使用 responses；仅实现 Chat Completions 的网关使用 chat_completions。
OPENAI_API_MODE=responses

HARNESS_MAX_TOKENS=8000
HARNESS_MAX_STEPS=100
HARNESS_CONTEXT_CHARS=160000
HARNESS_SHELL_TIMEOUT=120
HARNESS_REQUEST_TIMEOUT=120
HARNESS_MAX_RETRIES=3
# 可选：同一家 provider 的备用模型，仅瞬态网络/限流等错误耗尽后启用。
HARNESS_FALLBACK_MODEL=
# 长期记忆会额外调用模型进行选择、提取和合并；false 可关闭。
HARNESS_MEMORY=true
HARNESS_TIMEZONE=Asia/Shanghai
HARNESS_MCP_CONFIG=mcp.json
